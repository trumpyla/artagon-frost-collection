set -euo pipefail; \
metadata=$("cargo" metadata --format-version 1 --no-deps --locked); \
features=$(printf '%s\n' "$metadata" | "jq" -er '[.packages[] | select(.name == "frost-collections")] | if length != 1 then error("expected one Frost package") else .[0] end | .features | keys | map(select(. != "default" and . != "alloc" and . != "std" and . != "advanced" and . != "concurrent" and . != "frameworks")) | if length == 0 then error("no isolated features found") else .[] end'); \
while IFS= read -r feature; do \
  feature=${feature%$'\r'}; \
  printf '\nChecking isolated feature: %s\n' "$feature"; \
  "cargo" clippy --lib --no-default-features --features "$feature" --locked -- -D warnings; \
  "cargo" test --no-default-features --features "$feature" --locked; \
  RUSTDOCFLAGS="${RUSTDOCFLAGS:+${RUSTDOCFLAGS} }-D warnings" \
    "cargo" doc --no-default-features --features "$feature" --no-deps --locked; \
done <<< "$features"
set -euo pipefail; \
metadata=$("cargo" metadata --format-version 1 --no-deps --locked); \
examples=$(printf '%s\n' "$metadata" | "jq" -er '[.packages[] | select(.name == "frost-collections")] | if length != 1 then error("expected one Frost package") else .[0] end | [.targets[] | select(.kind | index("example")) | .name] | if length == 0 then error("no examples found") else .[] end'); \
while IFS= read -r example; do \
  example=${example%$'\r'}; \
  "cargo" run --example "$example" --all-features --locked; \
done <<< "$examples"
set -euo pipefail; \
metadata=$("cargo" metadata --format-version 1 --no-deps --locked); \
manifest=$(printf '%s\n' "$metadata" | "jq" -er '.target_directory as $target | [.packages[] | select(.name == "frost-collections")] | if length != 1 then error("expected one Frost package") else .[0] end | [$target, "package", (.name + "-" + .version), "Cargo.toml"] | join("/")'); \
manifest=${manifest%$'\r'}; \
"cargo" package --locked --all-features --allow-dirty; \
"cargo" test --manifest-path "$manifest" --all-features --locked; \
"cargo" test --manifest-path "$manifest" --examples --all-features --locked
"cargo" build --lib --locked --no-default-features --features int-set --target "thumbv6m-none-eabi"
"cargo" build --lib --locked --no-default-features --features int-set --target "thumbv7em-none-eabihf"
"cargo" build --lib --locked --no-default-features --target "thumbv7em-none-eabihf"
"cargo" build --lib --locked --no-default-features \
  --features alloc,hashbrown-0_17,indexmap-2,smallvec-1,arrayvec-0_7,fixedbitset-0_5,slotmap-1,phf-0_14,serde-1,borsh-1,schemars-1 \
  --target "thumbv7em-none-eabihf"
"cargo" "+nightly-2026-11-08" test --doc --all-features --locked
MIRIFLAGS='-Zmiri-strict-provenance' \
  "cargo" "+nightly-2026-11-08" miri test --locked --test inline_safety --test families --test core_review -- --skip under_random_ops
MIRIFLAGS='-Zmiri-tree-borrows -Zmiri-strict-provenance' \
  "cargo" "+nightly-2026-11-08" miri test --locked --test inline_safety
MIRIFLAGS='-Zmiri-tree-borrows -Zmiri-strict-provenance' \
  "cargo" "+nightly-2026-11-08" miri test --locked --test exhaustive_collections inline_ownership_exhausts_three_operation_traces
MIRIFLAGS='-Zmiri-strict-provenance' \
  "cargo" "+nightly-2026-11-08" miri test --locked --no-default-features --features int-set \
    --target i686-unknown-linux-gnu --test integer_sets dense_ -- --test-threads=1
MIRIFLAGS='-Zmiri-strict-provenance' \
  "cargo" "+nightly-2026-11-08" miri test --locked --no-default-features --features int-set \
    --target i686-unknown-linux-gnu --lib integer::storage::word::tests -- --test-threads=1
MIRIFLAGS='-Zmiri-strict-provenance' \
  "cargo" "+nightly-2026-11-08" miri test --locked --no-default-features --features int-set \
    --target i686-unknown-linux-gnu --lib integer::storage::tests -- --test-threads=1
set -euo pipefail; \
