+        }
+    }
+    pub(crate) fn max(self, other: Self) -> Self {
+        Self {
+            dense_bytes: self.dense_bytes.max(other.dense_bytes),
+            roaring_partitions: self.roaring_partitions.max(other.roaring_partitions),
+        }
+    }
+    fn auto_policy(self) -> IntSetPolicy {
