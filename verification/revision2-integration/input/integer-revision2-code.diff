+/// Runs of at least this many consecutive codes are inserted as ranges, which
+/// Roaring handles in time proportional to the number of runs rather than
+/// members; shorter stretches are appended in bulk.
+const RANGE_RUN: u64 = 32;
+
+/// Build a Roaring set from strictly ascending codes, appending sparse
+/// stretches in bulk and inserting long runs as ranges, then run-optimizing.
+fn roaring_from_sorted_impl<W: DenseToRoaring>(words: &[W]) -> W::Roaring {
+    let mut result = W::new();
+    let mut segment = 0; // start of the pending sparse stretch
+    let mut run = 0; // start of the current run
+    for index in 1..=words.len() {
+        let continues =
+            index < words.len() && words[index].to_u64() == words[index - 1].to_u64() + 1;
+        if continues {
+            continue;
+        }
+        let run_len = (index - run) as u64;
+        if run_len >= RANGE_RUN {
+            W::append(&mut result, &words[segment..run]);
+            W::insert_range(&mut result, words[run], words[index - 1]);
+            segment = index;
+        }
+        run = index;
+    }
+    W::append(&mut result, &words[segment..]);
+    optimize::<W>(&mut result);
+    result
+}
