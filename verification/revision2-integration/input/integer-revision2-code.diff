+impl DenseToRoaring for u64 {
+    fn build(base: u64, words: &[u64]) -> roaring::RoaringTreemap {
+        // Exclusive ends are computed widely: a window may reach `u64::MAX`.
+        let end = u128::from(base) + words.len() as u128 * 64;
+        let first = base >> 32;
+        let last = u64::try_from((end - 1) >> 32).expect("partition index fits");
+        let mut bitmaps = Vec::new();
+        for partition in first..=last {
+            let start = u128::from(partition) << 32;
+            let from = start.max(u128::from(base));
+            let to = (start + (1_u128 << 32)).min(end);
+            let slice = &words[usize::try_from((from - u128::from(base)) / 64)
+                .expect("partition index")
+                ..usize::try_from((to - u128::from(base)) / 64).expect("partition index")];
+            let offset = u32::try_from(from - start).expect("offset inside partition");
+            let bitmap =
+                roaring::RoaringBitmap::from_lsb0_bytes(offset, &Dense::<u64>::lsb0_bytes(slice));
+            if !bitmap.is_empty() {
+                bitmaps.push((u32::try_from(partition).expect("48-bit partition"), bitmap));
+            }
+        }
+        roaring::RoaringTreemap::from_bitmaps(bitmaps)
+    }
+    fn containers(value: &roaring::RoaringTreemap) -> u64 {
+        value
+            .bitmaps()
+            .map(|(_, bitmap)| u64::from(bitmap.statistics().n_containers))
+            .sum()
+    }
+    fn new() -> roaring::RoaringTreemap {
+        roaring::RoaringTreemap::new()
+    }
+    fn optimize(value: &mut roaring::RoaringTreemap) {
+        value.optimize();
+    }
+    fn append(value: &mut roaring::RoaringTreemap, codes: &[u64]) {
+        value
+            .append(codes.iter().copied())
+            .expect("codes are strictly ascending beyond the current maximum");
+    }
+    fn insert_range(value: &mut roaring::RoaringTreemap, low: u64, high: u64) {
+        value.insert_range(low..=high);
+    }
+}
+fn roaring_from_dense_impl<W: DenseToRoaring>(base: u64, words: &[u64]) -> W::Roaring {
+    W::build(base, words)
+}
