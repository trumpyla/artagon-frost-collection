{
  "schema": "frost-coverage-scope/v1",
  "host_target": "x86_64-unknown-linux-gnu",
  "toolchain_version": "1.99.1",
  "rustc_override": "",
  "rustup_toolchain_override": "",
  "tool_version": "cargo-llvm-cov 0.9.1",
  "features": "all-features",
  "ignore_filename_regex": "(^|/)(tests|benches|examples|verification|fuzz|frost-collections-test-support)/",
