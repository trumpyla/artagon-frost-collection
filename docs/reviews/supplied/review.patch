+
+/// Skewed inputs must use galloping: comparisons scale with the small side
+/// times a logarithm of the large side, not with the large side's length.
+#[test]
+fn skewed_inputs_gallop_instead_of_scanning_the_large_side() {
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    struct Counted {
+        key: u32,
+        comparisons: Rc<Cell<usize>>,
+    }
+    impl PartialEq for Counted {
+        fn eq(&self, other: &Self) -> bool {
+            self.key == other.key
+        }
+    }
+    impl Eq for Counted {}
+    impl PartialOrd for Counted {
+        fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+            Some(self.cmp(other))
+        }
+    }
+    impl Ord for Counted {
+        fn cmp(&self, other: &Self) -> Ordering {
+            self.comparisons.set(self.comparisons.get() + 1);
+            self.key.cmp(&other.key)
+        }
+    }
+
+    let comparisons = Rc::new(Cell::new(0));
+    let make_set = |keys: Vec<u32>| -> FrozenOrderedSet<Counted> {
+        keys.into_iter()
+            .map(|key| Counted {
+                key,
+                comparisons: Rc::clone(&comparisons),
+            })
+            .collect()
+    };
+    let big_n = 65_536_u32;
+    let small_n = 64_u32;
+    let big = make_set((0..big_n).map(|x| x * 2).collect());
+    // Half of the small members are present, half are absent, spread evenly.
+    let small = make_set(
+        (0..small_n)
+            .map(|x| x * (big_n / small_n) * 2 + u32::from(x % 2 == 1))
+            .collect(),
+    );
+    // Generous bound: 2·log2(m) + 4 comparisons per small member.
+    let budget = small_n as usize * (2 * (big_n.ilog2() as usize + 1) + 4);
+    assert!(
+        budget < big_n as usize / 4,
+        "the bound must be far below a linear scan"
+    );
+
+    for (name, run) in [
+        (
+            "intersection_len",
+            &(|| small.intersection_len(&big)) as &dyn Fn() -> usize,
+        ),
+        ("intersection_len (swapped)", &|| {
+            big.intersection_len(&small)
+        }),
+        ("difference_len", &|| small.difference_len(&big)),
+        ("union_len", &|| big.union_len(&small)),
+        ("symmetric_difference_len", &|| {
+            small.symmetric_difference_len(&big)
+        }),
+        ("intersection iterator", &|| {
+            small.intersection(&big).count_by_iteration()
+        }),
+        ("intersection iterator (swapped)", &|| {
+            big.intersection(&small).count_by_iteration()
+        }),
+        ("difference iterator", &|| {
+            small.difference(&big).count_by_iteration()
+        }),
+        ("is_subset", &|| usize::from(small.is_subset(&big))),
+        ("is_disjoint", &|| usize::from(small.is_disjoint(&big))),
+        ("is_disjoint (swapped)", &|| {
+            usize::from(big.is_disjoint(&small))
+        }),
+    ] {
+        comparisons.set(0);
+        let _ = run();
+        assert!(
+            comparisons.get() <= budget,
+            "{name}: {} comparisons exceed the galloping budget {budget}",
+            comparisons.get()
+        );
+    }
+
+    // Results are still exact.
+    assert_eq!(small.intersection_len(&big), small_n as usize / 2);
+    assert_eq!(small.difference_len(&big), small_n as usize / 2);
+    assert_eq!(
+        big.difference_len(&small),
+        big_n as usize - small_n as usize / 2
+    );
+    assert_eq!(small.union_len(&big), big_n as usize + small_n as usize / 2);
+    assert!(!small.is_subset(&big));
+    assert!(!small.is_disjoint(&big));
+    let present = make_set((0..small_n).map(|x| x * (big_n / small_n) * 2).collect());
+    assert!(present.is_subset(&big));
+    let absent = make_set(
+        (0..small_n)
+            .map(|x| x * (big_n / small_n) * 2 + 1)
+            .collect(),
+    );
+    assert!(absent.is_disjoint(&big));
+}
+
+trait CountByIteration: Iterator + Sized {
+    /// `Iterator::count` is specialised; this forces the `next` path.
+    fn count_by_iteration(mut self) -> usize {
+        let mut n = 0;
+        while self.next().is_some() {
+            n += 1;
+        }
+        n
+    }
+}
+impl<I: Iterator> CountByIteration for I {}
+
+proptest! {
+    /// Skewed random inputs exercise every galloping branch against std.
+    #[test]
+    fn skewed_algebra_matches_btree_sets_for_random_inputs(
+        small in proptest::collection::vec(-5000_i16..5000, 0..12),
+        large in proptest::collection::vec(-5000_i16..5000, 0..3000),
+    ) {
+        check_against_standard(&small, &large);
+        check_against_standard(&large, &small);
+    }
+
+    /// Inputs that start balanced and become skewed mid-traversal.
+    #[test]
+    fn mixed_regime_algebra_matches_btree_sets(
+        shared in proptest::collection::vec(-200_i16..0, 0..60),
+        tail in proptest::collection::vec(0_i16..5000, 0..2000),
+        probe in proptest::collection::vec(0_i16..5000, 0..6),
+    ) {
+        let mut left = shared.clone();
+        left.extend_from_slice(&probe);
+        let mut right = shared;
+        right.extend_from_slice(&tail);
+        check_against_standard(&left, &right);
+        check_against_standard(&right, &left);
+    }
+}
