+#[cfg(feature = "arc-swap-1")]
+mod snapshot_read_modify_write {
+    use frost::concurrent::SnapshotStore;
+    use frost::family::FrozenOrderedSet;
+    use std::sync::Arc;
+
+    #[test]
+    fn guard_and_peek_observe_the_same_version_as_load() {
+        let store = SnapshotStore::new(FrozenOrderedSet::from_iter([1, 2, 3]));
+        let loaded = store.load();
+        let guard = store.load_guard();
+        assert!(Arc::ptr_eq(&loaded, &guard));
+        assert_eq!(store.peek(FrozenOrderedSet::len), 3);
+        store.publish(FrozenOrderedSet::from_iter([9]));
+        // Earlier guard and load keep their version; new reads see the new one.
+        assert_eq!(guard.len(), 3);
+        assert_eq!(loaded.len(), 3);
+        assert_eq!(store.peek(FrozenOrderedSet::len), 1);
+    }
+
+    #[test]
+    fn publish_if_current_rejects_a_stale_expectation_and_returns_the_value() {
+        let store = SnapshotStore::new(FrozenOrderedSet::from_iter([1]));
+        let stale = store.load();
+        let fresh = store.publish(FrozenOrderedSet::from_iter([2]));
+        assert!(Arc::ptr_eq(&fresh, &stale));
+        let rejected = store
+            .publish_if_current(&stale, FrozenOrderedSet::from_iter([3]))
+            .unwrap_err();
+        assert_eq!(rejected.0, FrozenOrderedSet::from_iter([3]));
+        assert_eq!(rejected.1.as_slice(), &[2]);
+        let current = store.load();
+        let displaced = store
+            .publish_if_current(&current, FrozenOrderedSet::from_iter([4]))
+            .unwrap();
+        assert!(Arc::ptr_eq(&displaced, &current));
+        assert_eq!(store.load().as_slice(), &[4]);
+    }
+
+    #[test]
+    fn update_never_loses_concurrent_increments() {
+        let store = Arc::new(SnapshotStore::new(FrozenOrderedSet::<u32>::default()));
+        let writers = 8;
+        let per_writer = 250;
+        let handles: Vec<_> = (0..writers)
+            .map(|w| {
+                let store = Arc::clone(&store);
+                std::thread::spawn(move || {
+                    for i in 0..per_writer {
+                        store.update(|current| {
+                            current
+                                .iter()
+                                .copied()
+                                .chain(std::iter::once(w * per_writer + i))
+                                .collect()
+                        });
+                    }
+                })
+            })
+            .collect();
+        for handle in handles {
+            handle.join().unwrap();
+        }
+        // A blind load/derive/publish race would drop members; RCU keeps all.
+        assert_eq!(store.load().len(), (writers * per_writer) as usize);
+    }
+}
